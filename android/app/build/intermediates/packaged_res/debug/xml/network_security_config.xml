<?xml version="1.0" encoding="utf-8"?>
<!-- Панели часто живут на http://VPS:8000 — разрешаем cleartext, но не для всего мира по умолчанию -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

[Unit]
Description=Hydra Control Panel
Documentation=https://github.com/semenovna15133-code/hydra-panel
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=hydra
Group=hydra
WorkingDirectory=/opt/hydra/repo
EnvironmentFile=/etc/hydra/panel.env
# v0.7.0: явные пути к ресурсам и файлу лога — панель больше не зависит от cwd,
# а ошибки старта пишутся и в journalctl, и в /var/log/hydra/panel.log
Environment=HYDRA_TEMPLATES_DIR=/opt/hydra/repo/templates
Environment=HYDRA_STATIC_DIR=/opt/hydra/repo/static
Environment=HYDRA_DB_PATH=/var/lib/hydra/panel.db
Environment=HYDRA_LOG_FILE=/var/log/hydra/panel.log
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/opt/hydra/venv/bin/uvicorn hydra.panel:app --app-dir /opt/hydra/repo --host 0.0.0.0 --port 443 --ssl-certfile /etc/letsencrypt/live/panel.hydra.example/fullchain.pem --ssl-keyfile /etc/letsencrypt/live/panel.hydra.example/privkey.pem
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
